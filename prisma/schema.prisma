  UNLISTED
  PUBLIC
}

enum RegistrationChannel {
  PHONE
  WEB
  ADMIN
  IMPORT
  API
}

enum ParticipationStatus {
  ACTIVE
  WITHDRAWN
  DISQUALIFIED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum StageType {
  LEAGUE
  GROUP
  SWISS
  ROUND_ROBIN
  KNOCKOUT
  PLACEMENT
  QUALIFIER
  CUSTOM
}

enum MatchPublicationStatus {
  HIDDEN
  DRAFT
  PUBLISHED
}

enum MatchEventType {
  MATCH_START
  MATCH_END
  PERIOD_START
  PERIOD_END
  GOAL
  OWN_GOAL
  CARD
  PENALTY
  SHOOTOUT_ATTEMPT
  SUBSTITUTION
  SHOT
  STAT_UPDATE
  COMMENTARY
  TIMEOUT
  INJURY
  VAR_DECISION
  WICKET
  RUNS
  OVER_END
  SCORE_CORRECTION
  NOTE
  STATUS_CHANGE
  OTHER
}

enum OfficialRole {
  REFEREE
  ASSISTANT_REFEREE
  UMPIRE
  SCORER
  TIMEKEEPER
  MATCH_COMMISSIONER
  TECHNICAL_OFFICIAL
  OTHER
}

model TournamentProgressionLock {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  matchId   String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model TournamentVenue {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  tournamentId String     @db.ObjectId
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  shortName    String?
  slug         String?
  address      String?
  latitude     Float?
  longitude    Float?
  capacity     Int?
  timezone     String?
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)
  metadata     Json?
  matches      Matches[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([tournamentId, name])
  @@index([tournamentId, slug])
  @@index([tournamentId, isActive])
}

model TournamentStage {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  tournamentId    String          @db.ObjectId
  tournament      Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  gameId          String          @db.ObjectId
  game            TournamentGame  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name            String
  code            String
  type            StageType
  order           Int             @default(0)
  isActive        Boolean         @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  qualifiersCount Int?
  bracketSize     Int?
  config          Json?
  groups          StageGroup[]
  matches         Matches[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([gameId, code])
  @@index([tournamentId, gameId, order])
}

model StageGroup {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  stageId   String          @db.ObjectId
  stage     TournamentStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  code      String
  name      String
  order     Int             @default(0)
  metadata  Json?
  registrations GameRegistration[]
  matches   Matches[]
  standings StandingRow[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([stageId, code])
  @@index([stageId, order])
}

model StandingRow {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  tournamentId    String     @db.ObjectId
  gameId          String     @db.ObjectId
  groupId         String?    @db.ObjectId
  group           StageGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  familyId        String     @db.ObjectId
  familyName      String
  position        Int
  played          Int        @default(0)
  won             Int        @default(0)
  drawn           Int        @default(0)
  lost            Int        @default(0)
  points          Int        @default(0)
  scored          Int        @default(0)
  conceded        Int        @default(0)
  difference      Int        @default(0)
  bonusPoints     Int        @default(0)
  qualified       Boolean    @default(false)
  snapshotVersion Int        @default(1)
  computedAt      DateTime   @default(now())

  @@unique([gameId, groupId, familyId])
  @@index([tournamentId, gameId, position])
}

model MatchEvent {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  matchId      String         @db.ObjectId
  match        Matches        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  type         MatchEventType
  sequence     Int
  period       String?
  minute       Int?
  second       Int?
  familyId     String?        @db.ObjectId
  familyName   String?
  playerId     String?        @db.ObjectId
  playerName   String?
  secondaryPlayerId   String? @db.ObjectId
  secondaryPlayerName String?
  value        Int?
  description  String?
  metadata     Json?
  createdById String?         @db.ObjectId
  actionId    String?         // client-generated idempotency identifier
  createdAt    DateTime       @default(now())

  @@unique([matchId, sequence])
  @@index([matchId, createdAt])
  @@index([matchId, type])
  @@index([matchId, actionId])
  @@index([playerId])
  @@index([familyId])
}

model MatchOfficial {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  matchId   String       @db.ObjectId
  match     Matches      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  role      OfficialRole
  userId    String?      @db.ObjectId
  name      String
  phone     String?
  notes     String?
  status    OfficialAssignmentStatus @default(ASSIGNED)
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  assignedById String?    @db.ObjectId
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([matchId, role])
  @@index([userId, status])
  @@index([matchId, userId])
}

enum OfficialAssignmentStatus {
  ASSIGNED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

model PaymentAllocation {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  paymentId      String  @db.ObjectId
  payment        Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  registrationId String? @db.ObjectId
  tournamentId   String? @db.ObjectId
  gameId         String? @db.ObjectId
  amountMinor    Int
  currency       String  @default("INR")
  purpose        String?
  createdAt      DateTime @default(now())

  @@index([paymentId])
  @@index([registrationId])
  @@index([tournamentId, gameId])
}
